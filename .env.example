# Server
PORT=3000

# Supabase (required – use your project URL and anon or service role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# MinIO (used by docker-compose; override for local dev)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videos
# Public URL of this API (used for stream URLs returned to the frontend)
# PUBLIC_API_URL=http://localhost:3000
# Optional: secret for signing stream tokens (defaults to SUPABASE_KEY)
# STREAM_TOKEN_SECRET=your-secret

# AI provider
# local = Whisper + Ollama in docker-compose (free, good for development)
# openai = paid OpenAI API
AI_PROVIDER=local

# Local AI endpoints (used when AI_PROVIDER=local)
LOCAL_WHISPER_URL=http://whisper:9000
OLLAMA_URL=http://ollama:11434
LOCAL_CHAT_MODEL=llama3.1:8b
LOCAL_EMBEDDING_MODEL=mxbai-embed-large

# OpenAI (required only when AI_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
